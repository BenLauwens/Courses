333334 209.4,173.0584478689435 208.8,172.7662037037037 208.20000000000002,172.45510789195714 207.6,172.12350346565847 207,171.76954732510288 206.4,171.39118457300276 205.8,170.98611862267893 205.2,170.55177626606198 204.60000000000002,170.0852667063256 204,169.58333333333331 203.4,169.04229673460443 202.79999999999998,168.4579870729455 202.20000000000002,167.8256635013392 201.6,167.13991769547323 201,166.39455782312928 200.39999999999998,165.5824682814302 199.8,164.6954392408938 199.2,163.72395833333331 198.6,162.65695456122097 198,161.48148148148147 197.4,160.18232263178757 196.79999999999998,158.74149659863943 196.2,157.13763145861913 195.6,155.3451676528599 195,153.33333333333334 194.4,151.06481481481487 193.8,148.4940138626339 193.20000000000002,145.5647382920111 192.6,142.2071050642479 192,138.3333333333334 191.4,133.83194829178206 190.8,128.5596707818931 190.2,122.32987312572084 189.60000000000002,114.89583333333346 189,105.92592592592584 188.4,94.96598639455797 187.79999999999998,81.38067061143968 187.20000000000002,64.25925925925948 186.6,42.258953168043774 186,13.333333333333627 185.39999999999998,-25.761316872428637 184.8,-80.41666666666617 184.2,-160.13605442177027 183.6,-282.9629629629621 183,-486.6666666666714 182.4,-861.6666666666647 181.79999999999998,-1671.851851851876 181.2,-3986.666666666659 180.6,-16486.666666667377\" fill=\"none\" stroke=\"#ff0000\"></polyline><foreignObject x=\"164\" y=\"180\" width=\"14\" height=\"18\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>O</mi></math></div></foreignObject></svg><figcaption>The graph of <math><mfrac><mn>1</mn><msup><mi>x</mi><mn class=\"tml-sml-pad\">2</mn></msup></mfrac></math>.</figcaption></figure>","hidden":true,"type":"code"},{"input":"!!! example\n\n    As ``x`` approaches ``0`` from either side, the values of ``f\\left(x\\right)`` are positive and grow larger and larger, so the limit of ``f\\left(x\\right)`` as ``x`` approaches ``0`` *does not exist*. it is nevertheless convenient to describe the behaviour of ``f`` near ``0`` by saying that ``f\\left(x\\right)`` approaches ``\\infty`` as ``x`` tends to zero. We write\n\n    ```math\n    \\lim_{x\\to 0}f\\left(x\\right)=\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty\\,.\n    ```\n\n    Note that in writing this we are *not* saying that ``\\lim_{x\\to 0}\\frac{1}{x^2}`` *exists*. Rather, we are saying that the limit *does not exist because ``\\frac{1}{x^2}`` *becomes arbitrarily large near* ``x=0``. Observe how the graph of ``f`` approaches the ``y``-axis as ``x`` tends to ``0``. the ``y``-axis is a **vertical asymptote** of the graph.\n\n::: definition\nWe say that ``f:X\\mapsto Y`` approaches infinity as ``x`` tends to ``a`` and write\n\n```math\n\\lim_{x\\to a}f\\left(x\\right)=\\infty\\,.\n```\n\nif the following condition is satisfied:\n\n```math\n\\forall B>0,\\exists\\delta\\left(B\\right)>0:0<\\left|x-a\\right|<\\delta\\implies x\\in X\\wedge f\\left(x\\right)>B\\,.\n```\n:::\n\n!!! example \"Verify that\"\n\n    ```math\n    \\displaystyle\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty\\,.\n    ```\n\n    Let ``B`` be any positive number. We have\n\n    ```math\n    \\frac{1}{x^2}> B\\quad\\textrm{provided that}\\quad x^2<\\frac{1}{B}\\,.\n    ```\n\n    If ``\\delta =\\frac{1}{\\sqrt{B}}``, then\n\n    ```math\n    0<\\left|x\\right|<\\delta\\quad\\implies\\quad x^2<\\delta^2=\\frac{1}{B}\\quad\\implies\\quad\\frac{1}{x^2}>B\\,.\n    ```\n\n    Therefore, ``\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty``.\n\n!!! example \"Describe the behaviour of the function ``f\\left(x\\right)=\\frac{1}{x}`` near ``x=0``.\"\n\n","output":"","result":"!!! example\n\n    As ``x`` approaches ``0`` from either side, the values of ``f\\left(x\\right)`` are positive and grow larger and larger, so the limit of ``f\\left(x\\right)`` as ``x`` approaches ``0`` *does not exist*. it is nevertheless convenient to describe the behaviour of ``f`` near ``0`` by saying that ``f\\left(x\\right)`` approaches ``\\infty`` as ``x`` tends to zero. We write\n\n    ```math\n    \\lim_{x\\to 0}f\\left(x\\right)=\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty\\,.\n    ```\n\n    Note that in writing this we are *not* saying that ``\\lim_{x\\to 0}\\frac{1}{x^2}`` *exists*. Rather, we are saying that the limit *does not exist because ``\\frac{1}{x^2}`` *becomes arbitrarily large near* ``x=0``. Observe how the graph of ``f`` approaches the ``y``-axis as ``x`` tends to ``0``. the ``y``-axis is a **vertical asymptote** of the graph.\n\n::: definition\nWe say that ``f:X\\mapsto Y`` approaches infinity as ``x`` tends to ``a`` and write\n\n```math\n\\lim_{x\\to a}f\\left(x\\right)=\\infty\\,.\n```\n\nif the following condition is satisfied:\n\n```math\n\\forall B>0,\\exists\\delta\\left(B\\right)>0:0<\\left|x-a\\right|<\\delta\\implies x\\in X\\wedge f\\left(x\\right)>B\\,.\n```\n:::\n\n!!! example \"Verify that\"\n\n    ```math\n    \\displaystyle\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty\\,.\n    ```\n\n    Let ``B`` be any positive number. We have\n\n    ```math\n    \\frac{1}{x^2}> B\\quad\\textrm{provided that}\\quad x^2<\\frac{1}{B}\\,.\n    ```\n\n    If ``\\delta =\\frac{1}{\\sqrt{B}}``, then\n\n    ```math\n    0<\\left|x\\right|<\\delta\\quad\\implies\\quad x^2<\\delta^2=\\frac{1}{B}\\quad\\implies\\quad\\frac{1}{x^2}>B\\,.\n    ```\n\n    Therefore, ``\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty``.\n\n!!! example \"Describe the behaviour of the function ``f\\left(x\\right)=\\frac{1}{x}`` near ``x=0``.\"\n\n","resultHTML":"<div data-type=\"example\">\n<p>As <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> approaches <span class=\"math-tex\" data-type=\"tex\">\\(0\\)</span> from either side, the values of <span class=\"math-tex\" data-type=\"tex\">\\(f\\left(x\\right)\\)</span> are positive and grow larger and larger, so the limit of <span class=\"math-tex\" data-type=\"tex\">\\(f\\left(x\\right)\\)</span> as <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> approaches <span class=\"math-tex\" data-type=\"tex\">\\(0\\)</span> <em>does not exist</em>. it is nevertheless convenient to describe the behaviour of <span class=\"math-tex\" data-type=\"tex\">\\(f\\)</span> near <span class=\"math-tex\" data-type=\"tex\">\\(0\\)</span> by saying that <span class=\"math-tex\" data-type=\"tex\">\\(f\\left(x\\right)\\)</span> approaches <span class=\"math-tex\" data-type=\"tex\">\\(\\infty\\)</span> as <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> tends to zero. We write</p>\n<div data-type=\"equation\" class=\"math-tex\">\n\\[\n\\lim_{x\\to 0}f\\left(x\\right)=\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty\\,.\n\\]\n</div>\n<p>Note that in writing this we are <em>not</em> saying that <span class=\"math-tex\" data-type=\"tex\">\\(\\lim_{x\\to 0}\\frac{1}{x^2}\\)</span> <em>exists</em>. Rather, we are saying that the limit *does not exist because <span class=\"math-tex\" data-type=\"tex\">\\(\\frac{1}{x^2}\\)</span> <em>becomes arbitrarily large near</em> <span class=\"math-tex\" data-type=\"tex\">\\(x=0\\)</span>. Observe how the graph of <span class=\"math-tex\" data-type=\"tex\">\\(f\\)</span> approaches the <span class=\"math-tex\" data-type=\"tex\">\\(y\\)</span>-axis as <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> tends to <span class=\"math-tex\" data-type=\"tex\">\\(0\\)</span>. the <span class=\"math-tex\" data-type=\"tex\">\\(y\\)</span>-axis is a <strong>vertical asymptote</strong> of the graph.</p>\n</div>\n<div data-type=\"definition\">\n<p>We say that <span class=\"math-tex\" data-type=\"tex\">\\(f:X\\mapsto Y\\)</span> approaches infinity as <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> tends to <span class=\"math-tex\" data-type=\"tex\">\\(a\\)</span> and write</p>\n<div data-type=\"equation\" class=\"math-tex\">\n\\[\n\\lim_{x\\to a}f\\left(x\\right)=\\infty\\,.\n\\]\n</div>\n<p>if the following condition is satisfied:</p>\n<div data-type=\"equation\" class=\"math-tex\">\n\\[\n\\forall B&gt;0,\\exists\\delta\\left(B\\right)&gt;0:0&lt;\\left|x-a\\right|&lt;\\delta\\implies x\\in X\\wedge f\\left(x\\right)&gt;B\\,.\n\\]\n</div>\n</div>\n<div data-type=\"example\">\n<h5>Verify that</h5>\n<div data-type=\"equation\" class=\"math-tex\">\n\\[\n\\displaystyle\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty\\,.\n\\]\n</div>\n<p>Let <span class=\"math-tex\" data-type=\"tex\">\\(B\\)</span> be any positive number. We have</p>\n<div data-type=\"equation\" class=\"math-tex\">\n\\[\n\\frac{1}{x^2}&gt; B\\quad\\textrm{provided that}\\quad x^2&lt;\\frac{1}{B}\\,.\n\\]\n</div>\n<p>If <span class=\"math-tex\" data-type=\"tex\">\\(\\delta =\\frac{1}{\\sqrt{B}}\\)</span>, then</p>\n<div data-type=\"equation\" class=\"math-tex\">\n\\[\n0&lt;\\left|x\\right|&lt;\\delta\\quad\\implies\\quad x^2&lt;\\delta^2=\\frac{1}{B}\\quad\\implies\\quad\\frac{1}{x^2}&gt;B\\,.\n\\]\n</div>\n<p>Therefore, <span class=\"math-tex\" data-type=\"tex\">\\(\\lim_{x\\to 0}\\frac{1}{x^2}=\\infty\\)</span>.</p>\n</div>\n<div data-type=\"example\">\n<h5>Describe the behaviour of the function <span class=\"math-tex\" data-type=\"tex\">\\(f\\left(x\\right)=\\frac{1}{x}\\)</span> near <span class=\"math-tex\" data-type=\"tex\">\\(x=0\\)</span>.</h5>\n</div>\n","hidden":true,"type":"markdown","translations":{},"translationSource":null},{"input":"const scale = 40;\nconst figure = JSCells.figure({\n    width: 8 * scale,\n    height: 8 * scale,\n    caption: \"The graph of \\\\(\\\\frac{1}{x}\\\\).\",\n});\n\nfigure.axes({\n    origin: [4 * scale, 4 * scale],\n    scale,\n    x: { ticks: [-1, 1] },\n    y: { ticks: [-1, 1] },\n});\n\nconst f = (x) => 1 / x;\n\nfigure.plot(f, {\n    domain: [-4, 0],\n    samples: 401,\n    stroke: \"#ff0000\",\n});\nfigure.plot(f, {\n    domain: [4, 0],\n    samples: 401,\n    stroke: \"#ff0000\",\n});\n\nfigure.label(\"O\", {\n    x: 4 * scale - 16,\n    y: 4 * scale,\n    latex: true,\n    width: 14,\n    height: 18,\n});\n\nfigure;","output":"","result":"xy−11−11OThe graph of 1x.","resultHTML":"<figure><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"320\" height=\"320\" viewBox=\"0 0 320 320\"><line x1=\"0\" y1=\"160\" x2=\"320\" y2=\"160\" stroke=\"#000000\"></line><line x1=\"160\" y1=\"0\" x2=\"160\" y2=\"320\" stroke=\"#000000\"></line><polygon points=\"320,160 313,156 313,164\" fill=\"#000000\" stroke=\"#000000\"></polygon><polygon points=\"160,0 156,7 164,7\" fill=\"#000000\" stroke=\"#000000\"></polygon><foreignObject x=\"306\" y=\"130\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>x</mi></math></div></foreignObject><foreignObject x=\"168\" y=\"-2\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>y</mi></math></div></foreignObject><line x1=\"120\" y1=\"156\" x2=\"120\" y2=\"164\" stroke=\"#000000\"></line><foreignObject x=\"116\" y=\"168\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mrow><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></math></div></foreignObject><line x1=\"200\" y1=\"156\" x2=\"200\" y2=\"164\" stroke=\"#000000\"></line><foreignObject x=\"196\" y=\"168\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mn>1</mn></math></div></foreignObject><line x1=\"156\" y1=\"200\" x2=\"164\" y2=\"200\" stroke=\"#000000\"></line><foreignObject x=\"136\" y=\"188\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mrow><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></math></div></foreignObject><line x1=\"156\" y1=\"120\" x2=\"164\" y2=\"120\" stroke=\"#000000\"></line><foreignObject x=\"136\" y=\"108\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mn>1</mn></math></div></foreignObject><polyline points=\"0,170 0.39999999999997726,170.0250626566416 0.8000000000000114,170.0502512562814 1.1999999999999886,170.07556675062972 1.5999999999999943,170.1010101010101 2,170.126582278481 2.4000000000000057,170.1522842639594 2.799999999999983,170.17811704834605 3.1999999999999886,170.20408163265307 3.5999999999999943,170