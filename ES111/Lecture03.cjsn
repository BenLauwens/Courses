4 129.5,94.72749999999999 130.2,94.1584 130.9,93.5851 131.6,93.00760000000001 132.3,92.42590000000001 133,91.84 133.7,91.24990000000001 134.39999999999998,90.65559999999999 135.1,90.05710000000002 135.8,89.4544 136.5,88.8475 137.2,88.2364 137.89999999999998,87.62110000000001 138.6,87.0016 139.3,86.37790000000001 140,85.75 140.7,85.11790000000002 141.4,84.48160000000001 142.09999999999997,83.84110000000001 142.8,83.19640000000001 143.5,82.54750000000001 144.2,81.89439999999999 144.89999999999998,81.23710000000001 145.60000000000002,80.5756 146.29999999999998,79.90990000000002 147,79.24 147.7,78.56590000000001 148.4,77.88759999999999 149.1,77.20510000000002 149.8,76.51839999999999 150.5,75.82750000000001 151.20000000000002,75.13239999999999 151.89999999999998,74.43310000000001 152.60000000000002,73.72959999999999 153.3,73.02190000000002 154,72.30999999999999 154.7,71.59390000000002 155.40000000000003,70.87359999999998 156.1,70.1491 156.8,69.42039999999999 157.5,68.6875 158.2,67.95040000000002 158.9,67.20909999999999 159.59999999999997,66.46360000000003 160.3,65.71390000000001 161,64.96000000000001 161.7,64.20190000000001 162.39999999999998,63.43960000000001 163.1,62.67309999999998 163.79999999999998,61.902400000000014 164.5,61.12749999999998 165.2,60.3484 165.9,59.56509999999999 166.6,58.77759999999999 167.3,57.98589999999999 168,57.19 168.70000000000002,56.3899 169.4,55.5856 170.10000000000002,54.777099999999976 170.79999999999998,53.9644 171.5,53.14749999999998 172.2,52.32639999999999 172.9,51.50109999999998 173.6,50.67160000000001 174.3,49.83789999999996 175,49\" fill=\"none\" stroke=\"#ff0000\" stroke-width=\"1\"></polyline><circle cx=\"105\" cy=\"112\" r=\"3\" fill=\"#ff0000\" stroke=\"#ff0000\"></circle><foreignObject x=\"77\" y=\"0\" width=\"60\" height=\"22\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mrow><mi>y</mi><mo>=</mo><mi>f</mi><mrow><mo fence=\"true\" stretchy=\"true\">(</mo><mi>x</mi><mo fence=\"true\" stretchy=\"true\">)</mo></mrow></mrow></