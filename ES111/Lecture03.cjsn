.org/1999/xhtml\"><math><mi>O</mi></math></div></foreignObject><foreignObject x=\"554\" y=\"115\" width=\"14\" height=\"22\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>x</mi></math></div></foreignObject><foreignObject x=\"482\" y=\"-2\" width=\"14\" height=\"22\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>y</mi></math></div></foreignObject><line x1=\"510\" y1=\"132\" x2=\"510\" y2=\"138\" stroke=\"#000000\"></line><foreignObject x=\"489\" y=\"135\" width=\"42\" height=\"22\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mn>0.5</mn></math></div></foreignObject><line x1=\"540\" y1=\"132\" x2=\"540\" y2=\"138\" stroke=\"#000000\"></line><foreignObject x=\"533\" y=\"135\" width=\"14\" height=\"22\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mn>1</mn></math></div></foreignObject><polyline points=\"36,-465 36.6,-410.4545454545455 37.2,-364.99999999999994 37.8,-326.5384615384615 38.4,-293.57142857142856 39,-264.99999999999994 39.6,-240 40.2,-217.9411764705883 40.8,-198.33333333333331 41.4,-180.78947368421052 42,-165 42.6,-150.71428571428572 43.2,-137.7272727272727 43.8,-125.86956521739131 44.4,-115.00000000000003 45,-105 45.6,-95.76923076923075 46.2,-87.2222222222222 46.8,-79.28571428571428 47.400000000000006,-71.89655172413791 48,-64.99999999999997 48.6,-58.54838709677415 49.2,-52.5 49.8,-46.81818181818184 50.400000000000006,-41.470588235294116 51,-36.428571428571445 51.599999999999994,-31.666666666666657 52.2,-27.16216216216216 52.8,-22.89473684210526 53.400000000000006,-18.84615384615384 54,-15 54.6,-11.341463414634148 55.2,-7.857142857142861 55.800000000000004,-4.534883720930225 56.400000000000006,-1.3636363636363455 57,1.6666666666666572 57.599999999999994,4.565217391304316 58.2,7.340425531914917 58.8,9.999999999999986 59.4,12.551020408163268 60,15 60.6,17.352941176470594 61.2,19.615384615384627 61.8,21.792452830188694 62.400000000000006,23.8888888888889 63,25.909090909090907 63.599999999999994,27.857142857142847 64.2,29.736842105263