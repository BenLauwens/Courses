613,223.1058578630005 118.45654624300492,223.24959994242113 118.9560467745337,223.39181366368842 119.4555473060625,223.53252327362736 119.9550478375913,223.67175250887203 120.45454836912009,223.80952460921432 120.95404890064889,223.94586233053587 121.45354943217768,224.08078795733795 121.95304996370646,224.21432331488433 122.45255049523526,224.34648978097056 122.95205102676405,224.47730829733305 123.45155155829283,224.60679938071104 123.95105208982163,224.7349831335734 124.45055262135043,224.8618792545222 124.95005315287922,224.98750704838437 125.44955368440802,225.11188543600213 125.94905421593681,225.23503296373306 126.4485547474656,225.35696781266904 126.94805527899437,225.47770780758478 127.44755581052316,225.5972704256239 127.94705634205197,225.71567280473278 128.4465568735808,225.83293175184957 128.94605740510957,225.94906375085748 129.44555793663835,226.0640849703094 129.94505846816713,226.17801127093256 130.44455899969591,226.29085821291918 130.94405953122472,226.40264106301137 131.44356006275353,226.51337480138648 131.94306059428231,226.62307412834917 132.4425611258111,226.73175347083736 132.94206165733988,226.83942698874694 133.4415621888687,226.9461085810822 133.9410627203975,227.05181189193672 134.44056325192628,227.15655031631064 134.94006378345506,227.26033700576926 135.43956431498384,227.36318487394817 135.93906484651262,227.4651066019096 136.43856537804146,227.56611464335472 136.93806590957024,227.66622122969645 137.43756644109902,227.76543837499688 137.9370669726278,227.86377788077394 138.43656750415659,227.96125134068083 138.9360680356854,228.0578701450625 139.4355685672142,228.15364548539281 139.93506909874299,228.24858835859575 140.4345696302718,228.34270957125486 140.93407016180058,228.4360197437135 141.43357069332936,228.52852931406983 141.93307122485814,228.62024854206908 142.43257175638692,228.7111875128969 142.93207228791573,228.80135614087592 143.43157281944454,228.89076417306904 143.93107335097332,228.97942119279173 144.43057388250213,229.