192587 220,88.39340169263846 220.5,87.0954501571976 221,85.78847065488083 221.5,84.47240039121255 222,83.14717613494707 222.5,81.81273421503084 223,80.4690105175429 223.5,79.11594048261466 224.00000000000003,77.7534591013281 224.5,76.3815009125928 225,75 225.5,73.60888998865627 225.99999999999997,72.20810404199423 226.5,70.79757485856132 227,69.37723466878668 227.5,67.94701523172452 228,66.50684783177576 228.5,65.05666327538648 229,63.59639188772391 229.5,62.125963509328045 230,60.64530749274141 230.5,59.1543526991145 231,57.65302749478835 231.5,56.141259747852104 232,54.6189768246779 232.5,53.08610558643093 233,51.542572385555985 233.5,49.98830306223812 234,48.42322294084033 234.5,46.84725682631523 235,45.260329000592975 235.5,43.66236321894252 236,42.05328270630889 236.50000000000003,40.43301015362414 237,38.80146771409389 237.5,37.15857699945579 238,35.50425907621428 238.49999999999997,33.83843446184801 239,32.16102312099059 239.5,30.471944461586276 240,28.771117331016796 240.5,27.058460012202744 241,25.333890219677585 241.5,23.597325095634318 242,21.848681205944047 242.5,20.087874536147638 243,18.314820487419126 243.5,16.529433872501556 244,14.731628911613313 244.5,12.921319228327434 245,11.098417845421068 245.5,9.262837180697659 246,7.414489042777575 246.5,5.553284626862023 247,3.6791345104655306 247.5,1.7919486491208545 248,-0.10836362794873367 248.5,-2.021893622184905 249.00000000000003,-3.9487332700811635 249.5,-5.888975147599467 250,-7.84271247461902 250.5,-9.810039119414284 250.99999999999997,-11.79104960316539 251.5,-13.785839104499303 252,-15.794503464062132 252.5,-17.817139189125044 253,-19.853843458220126 253.5,-21.904714125809903 254,-23.969849726987718 254.5,-26.049349482213415 254.99999999999997,-28.143313302079548 255.50000000000003,-30.251841792111918 256,-32.37503625760246 256.5,-34.512998708477994 257,-36.665831864199845 257.5,-38.83363915870035 258,-41.016524745350864 258.5,-43.21459350196744 259,-45.427951035848764 259.5,-47.6567036888506 260,-49.90095854249421 260.5,-52.16082342311245 261,-54.43640690702921 261.5,-56.72781832577675 262,-59.0351677713478 262.5,-61.35856610148579 263,-63.69812494501082 263.5,-66.05395670718258 264,-68.42617457510158 264.5,-70.81489252314606 265,-73.2202253184496 265.5,-75.64228852641395 266,-78.08119851626202 266.5,-80.5370724666281 267,-83.01002837118892 267.5,-85.500185044332 268,-88.00766212686443 268.5,-90.53258009176022 269,-93.07506024995001 269.5,-95.63522475614826 270,-98.21319661472307 270.5,-100.80909968560479 271,-103.42305869023835 271.5,-106.05519921757491 272,-108.70564773010585 272.5,-111.37453156993831 273,-114.0619789649142 273.5,-116.76811903477068 274,-119.49308179734379 274.5,-122.2369981748144 275,-125\" fill=\"none\" stroke=\"black\" stroke-width=\"1\" stroke-dasharray=\"1, 2\"></polyline></svg><figcaption><math><mrow><mi>y</mi><mo>=</mo><msup><mn>2</mn><mi>x</mi></msup></mrow></math> for rational <math><mi>x</mi></math>.</figcaption></figure>","hidden":true,"type":"code"},{"input":"In the previous figure we plot points with coordinates ``\\left(x,2^x\\right)`` for many closely spaced rational values of ``x``. They appear to lie on a smooth curve. The definition of ``a^x`` can be extended to irrational ``x`` in such a way that ``a^x`` becomes a differentiable function of ``x`` on the whole real line. We will do so in the next section. For the moment, if ``x`` is irrational we can regard ``a^x`` as being the limit of values ``a^r`` for rational numbers rapproaching ``x``.\n\nExponential functions satisfy several identities called *laws of exponents*:\n\n::: proposition\nIf ``a>0`` and ``b>0``, and ``x`` and ``y`` are any real numbers, then\n```math\n\\begin{aligned}\n&a^0=1&&a^{x+y}=a^xa^y\\\\\n&a^{-x}=\\frac{1}{a^x}&&a^{x-y}=\\frac{a^x}{a^y}\\\\\n&\\left(a^x\\right)^y=a^{xy}&&\\left(ab\\right)^x=a^xb^x\n\\end{aligned}\n```\n:::\n\nThese identities can be proved for rational exponents using the definitions above. They remain true for irrational exponents, but we can’t show that until the next section.","output":"","result":"In the previous figure we plot points with coordinates ``\\left(x,2^x\\right)`` for many closely spaced rational values of ``x``. They appear to lie on a smooth curve. The definition of ``a^x`` can be extended to irrational ``x`` in such a way that ``a^x`` becomes a differentiable function of ``x`` on the whole real line. We will do so in the next section. For the moment, if ``x`` is irrational we can regard ``a^x`` as being the limit of values ``a^r`` for rational numbers rapproaching ``x``.\n\nExponential functions satisfy several identities called *laws of exponents*:\n\n::: proposition\nIf ``a>0`` and ``b>0``, and ``x`` and ``y`` are any real numbers, then\n```math\n\\begin{aligned}\n&a^0=1&&a^{x+y}=a^xa^y\\\\\n&a^{-x}=\\frac{1}{a^x}&&a^{x-y}=\\frac{a^x}{a^y}\\\\\n&\\left(a^x\\right)^y=a^{xy}&&\\left(ab\\right)^x=a^xb^x\n\\end{aligned}\n```\n:::\n\nThese identities can be proved for rational exponents using the definitions above. They remain true for irrational exponents, but we can’t show that until the next section.","resultHTML":"<p>In the previous figure we plot points with coordinates <span class=\"math-tex\" data-type=\"tex\">\\(\\left(x,2^x\\right)\\)</span> for many closely spaced rational values of <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span>. They appear to lie on a smooth curve. The definition of <span class=\"math-tex\" data-type=\"tex\">\\(a^x\\)</span> can be extended to irrational <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> in such a way that <span class=\"math-tex\" data-type=\"tex\">\\(a^x\\)</span> becomes a differentiable function of <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> on the whole real line. We will do so in the next section. For the moment, if <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> is irrational we can regard <span class=\"math-tex\" data-type=\"tex\">\\(a^x\\)</span> as being the limit of values <span class=\"math-tex\" data-type=\"tex\">\\(a^r\\)</span> for rational numbers rapproaching <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span>.</p>\n<p>Exponential functions satisfy several identities called <em>laws of exponents</em>:</p>\n<div data-type=\"proposition\">\n<p>If <span class=\"math-tex\" data-type=\"tex\">\\(a&gt;0\\)</span> and <span class=\"math-tex\" data-type=\"tex\">\\(b&gt;0\\)</span>, and <span class=\"math-tex\" data-type=\"tex\">\\(x\\)</span> and <span class=\"math-tex\" data-type=\"tex\">\\(y\\)</span> are any real numbers, then</p>\n<div data-type=\"equation\" class=\"math-tex\">\n\\[\n\\begin{aligned}\n&amp;a^0=1&amp;&amp;a^{x+y}=a^xa^y\\\\\n&amp;a^{-x}=\\frac{1}{a^x}&amp;&amp;a^{x-y}=\\frac{a^x}{a^y}\\\\\n&amp;\\left(a^x\\right)^y=a^{xy}&amp;&amp;\\left(ab\\right)^x=a^xb^x\n\\end{aligned}\n\\]\n</div>\n</div>\n<p>These identities can be proved for rational exponents using the definitions above. They remain true for irrational exponents, but we can’t show that until the next section.</p>\n","hidden":true,"type":"markdown","translations":{},"translationSource":null},{"input":"const scale = 50;\nconst fontX = 14;\nconst fontY = 18;\nconst xmid = 2.5 * scale;\nconst ymid = 5.5 * scale;\n\nconst figure = JSCells.figure({\n    width: 5 * scale,\n    height: 6 * scale,\n    caption: String.raw`Graphs of some exponential functions \\(y=a^x\\).`,\n});\n\nfigure.axes({\n    origin: [xmid, ymid],\n    scale,\n    x: { ticks: [-2, -1, 1, 2] },\n    y: { ticks: [1, 2, 3, 4, 5] },\n});\n\nconst curves = [\n    [0.1, \"cyan\", String.raw`a=\\frac{1}{10}`, -0.78, -0.02, 3, 2],\n    [0.25, \"RoyalBlue\", String.raw`a=\\frac{1}{4}`, -1.8, 1, 3, 2],\n    [0.5, \"purple\", String.raw`a=\\frac{1}{2}`, -2.5, 2, 3, 2],\n    [1, \"olive\", \"a=1\", 1.5, 4.5, 3, 1],\n    [2, \"green\", \"a=2\", 1.75, 2, 3, 1],\n    [4, \"orange\", \"a=4\", 1, 1.3, 3, 1],\n    [10, \"red\", \"a=10\", -0.2, 0.2, 4, 1],\n];\n\nfor (const [a, color, tex, dx, y, columns, rows] of curves) {\n    figure.plot((x) => a ** x, {\n        domain: [-3, 3],\n        samples: 601,\n        width: 1,\n        stroke: color,\n    });\n\n    const label = figure.math()\n        .x(xmid + dx * scale)\n        .y(y * scale)\n        .width(columns * fontX)\n        .height(rows * fontY)\n        .latex(tex);\n\n    label.element().style.color = color;\n}\n\nfigure;","output":"","result":"xy−2−11212345a=110a=14a=12a=1a=2a=4a=10Graphs of some exponential functions y=ax.","resultHTML":"<figure><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"250\" height=\"300\" viewBox=\"0 0 250 300\"><line x1=\"0\" y1=\"275\" x2=\"250\" y2=\"275\" stroke=\"#000000\"></line><line x1=\"125\" y1=\"0\" x2=\"125\" y2=\"300\" stroke=\"#000000\"></line><polygon points=\"250,275 243,271 243,279\" fill=\"#000000\" stroke=\"#000000\"></polygon><polygon points=\"125,0 121,7 129,7\" fill=\"#000000\" stroke=\"#000000\"></polygon><foreignObject x=\"236\" y=\"245\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>x</mi></math></div></foreignObject><foreignObject x=\"133\" y=\"-2\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>y</mi></math></div></foreignObject><line x1=\"25\" y1=\"271\" x2=\"25\" y2=\"279\" stroke=\"#000000\"></line><foreignObject x=\"9\" y=\"283\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; width: 100%; height: 100%; justify-content: center; align-items: flex-start;\"><math><mrow><mo stretchy=\"false\">−</mo><mn>2</mn></mrow></math></div></foreignObject><line x1=\"75\" y1=\"271\" x2=\"75\" y2=\"279\" stroke=\"#000000\"></line><foreignObject x=\"59\" y=\"283\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; width: 100%; height: 100%; justify-content: center; align-items: flex-start;\"><math><mrow><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></math></div></foreignObject><line x1=\"175\" y1=\"271\" x2=\"175\"