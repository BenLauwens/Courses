68869036 540.4,58.618279903707936 540.8,58.560690699705034 541.2,58.50342158849288 541.6,58.4464770399387 542,58.389861481692954 542.4,58.333579298920654 542.8,58.277634834036576 543.2,58.22203238644456 543.6,58.16677621228084 544,58.11187052416135 544.4000000000001,58.057319490933196 544.8,58.00312723743014 545.2,57.9492978442322 545.5999999999999,57.895835347429305 546,57.842743738389174 546.4,57.79002696352922 546.8,57.73768892409269 547.2,57.68573347592886 547.5999999999999,57.63416442927755 548,57.58298554855762 548.4,57.53220055215989 548.8,57.48181311224407 549.2,57.43182685453999 549.6,57.3822453581531 550,57.33307215537412 550.4,57.28431073149296 550.8,57.23596452461694 551.2,57.18803692549322 551.6,57.14053127733555 552,57.09345087565524 552.4,57.046798968096496 552.8,57.00057875427594 553.2,56.954793385626594 553.6,56.90944596524602 554,56.86453954774884 554.4000000000001,56.820077139123605 554.8,56.77606169659394 555.2,56.73249612848405 555.5999999999999,56.68938329408856 556,56.64672600354667 556.4,56.60452701772071 556.8,56.562789048079026 557.2,56.52151475658313 557.5999999999999,56.48070675557938 558,56.440367607694824 558.4,56.40049982573761 558.8,56.36110587260154 559.2,56.32218816117517 559.6,56.28374905425516 560,56.24579086446406\" fill=\"none\" stroke=\"#ff0000\" stroke-width=\"1\"></polyline><circle cx=\"280\" cy=\"20\" r=\"3\" fill=\"#ffffff\" stroke=\"#ff0000\"></circle></svg><figcaption><math><mrow><msub><mi>lim</mi><mrow><mi>θ</mi><mo stretchy=\"false\">→</mo><mn>0</mn></mrow></msub><mo>⁡</mo><mspace width=\"0.1667em\"></mspace><mfrac><mrow><mrow><mi>sin</mi><mo>⁡</mo></mrow><mrow><mo fence=\"true\" stretchy=\"false\">(</mo><mi>θ</mi><mo fence=\"true\" stretchy=\"false\">)</mo></mrow></mrow><mi>θ</mi></mfrac><mo>=</mo><mn>1</mn></mrow></math></figcaption></figure>","hidden":true,"type":"code"},{"input":"!!! theorem\n\t``\\displaystyle\\lim_{\\theta\\to 0}\\frac{\\sin\\theta}{\\theta}=1\\,.``","output":"","result":"!!! theorem\n\t``\\displaystyle\\lim_{\\theta\\to 0}\\frac{\\sin\\theta}{\\theta}=1\\,.``","resultHTML":"<aside class=\"markdown-admonition markdown-admonition-theorem\"><div class=\"markdown-admonition-title\">Theorem</div><div class=\"markdown-admonition-body\"><p><math><mstyle scriptlevel=\"0\" displaystyle=\"true\"><munder><mi>lim</mi><mrow><mi>θ</mi><mo>→</mo><mn>0</mn></mrow></munder><mo>⁡</mo><mspace width=\"0.1667em\"></mspace><mfrac><mrow><mrow><mi>sin</mi><mo>⁡</mo><mspace width=\"0.1667em\"></mspace></mrow><mi>θ</mi></mrow><mi>θ</mi></mfrac><mo>=</mo><mn>1</mn><mspace width=\"0.1667em\"></mspace><mi>.</mi></mstyle></math></p></div></aside>","hidden":true,"type":"markdown","translations":{},"translationSource":null},{"input":"const scale = 75;\nconst xmid = 1.25 * scale;\nconst ymid = 1.8 * scale;\nconst theta = Math.PI / 3;\nconst cosTheta = Math.cos(theta);\nconst sinTheta = Math.sin(theta);\nconst tanTheta = Math.tan(theta);\n\nconst figure = JSCells.figure({\n    width: 265,\n    height: 225,\n    caption: \"Area triangle OAP < Area sector OAP < Area triangle OAT\",\n});\n\nfigure.axes({\n    origin: [xmid, ymid],\n    scale,\n    x: { ticks: [-1, 1] },\n    y: { ticks: [-1, 1] },\n});\n\nfigure.label(\"O\", {\n    x: xmid - 16,\n    y: ymid,\n    width: 14,\n    height: 22,\n    latex: true,\n});\n\nfigure.plot((x) => Math.sqrt(Math.max(0, 1 - x ** 2)), {\n    domain: [-1, 1],\n    samples: 201,\n    stroke: \"#ff0000\",\n    width: 1,\n});\nfor (const x of [-1, 0, 1]) {\n    figure.point(x, Math.sqrt(Math.max(0, 1 - x ** 2)), {\n        radius: 3,\n        fill: \"#ff0000\",\n        stroke: \"#ff0000\",\n    });\n}\n\nfigure.plot((x) => -Math.sqrt(Math.max(0, 1 - x ** 2)), {\n    domain: [-1, 1],\n    samples: 201,\n    stroke: \"#ff0000\",\n    width: 1,\n});\nfigure.point(0, -1, { radius: 3, fill: \"#ff0000\", stroke: \"#ff0000\" });\n\nfigure.plot((x) => tanTheta * x, {\n    domain: [0, 1],\n    samples: 11,\n    stroke: \"#4169e1\",\n    width: 1,\n});\nfor (const x of [cosTheta, 1]) {\n    figure.point(x, tanTheta * x, {\n        radius: 3,\n        fill: \"#4169e1\",\n        stroke: \"#4169e1\",\n    });\n}\n\nconst arcRadius = scale / 3;\nconst arcEndX = xmid + cosTheta * arcRadius;\nconst arcEndY = ymid - sinTheta * arcRadius;\n\nfigure.path()\n    .d(`M ${xmid + arcRadius} ${ymid} A ${arcRadius} ${arcRadius} 0 0 0 ${arcEndX} ${arcEndY}`)\n    .stroke(\"#4169e1\")\n    .strokeWidth(1)\n    .fill(\"none\");\n\nconst tangentX = -sinTheta;\nconst tangentY = -cosTheta;\nconst baseX = arcEndX - tangentX * 6;\nconst baseY = arcEndY - tangentY * 6;\nconst normalX = -tangentY;\nconst normalY = tangentX;\n\nfigure.polygon()\n    .points([\n        `${arcEndX},${arcEndY}`,\n        `${baseX + normalX * 3},${baseY + normalY * 3}`,\n        `${baseX - normalX * 3},${baseY - normalY * 3}`,\n    ].join(\" \"))\n    .fill(\"#4169e1\");\n\nfigure.label(\"\\\\color{#ff0000}θ\", {\n    x: xmid + scale / 2 +26,\n    y: ymid - (2 / 3) * scale-5,\n    fill: \"#ff0000\",\n    latex: true,\n});\nfigure.label(\"\\\\color{#4169e1}θ\", {\n    x: xmid + scale / 5 +9,\n    y: ymid - scale / 10-20,\n    fill: \"#4169e1\",\n    latex: true,\n});\n\nfigure.label(\"A\", {\n    x: xmid + scale + 2,\n    y: ymid,\n    width: 14,\n    height: 22,\n    latex: true,\n});\nfigure.label(\"T\", {\n    x: xmid + scale + 2,\n    y: ymid - tanTheta * scale - 9,\n    width: 14,\n    height: 22,\n    latex: true,\n});\nfigure.label(String.raw`P=\\left(\\cos \\theta, \\sin \\theta\\right)`, {\n    x: xmid + scale * cosTheta+10,\n    y: ymid - scale * sinTheta - 9,\n    width: 10 * 14,\n    height: 22,\n    latex: true,\n});\n\nfigure.line()\n    .x1(xmid + scale).y1(ymid)\n    .x2(xmid + scale).y2(ymid - tanTheta * scale)\n    .stroke(\"#4169e1\");\n\nfigure.line()\n    .x1(xmid + scale).y1(ymid)\n    .x2(xmid + cosTheta * scale).y2(ymid - sinTheta * scale)\n    .stroke(\"#4169e1\");\n\nfigure;","output":"","result":"xy−11−11OθθATP=(cos⁡θ,sin⁡θ)Area triangle OAP < Area sector OAP < Area triangle OAT","resultHTML":"<figure><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"265\" height=\"225\" viewBox=\"0 0 265 225\"><line x1=\"0\" y1=\"135\" x2=\"265\" y2=\"135\" stroke=\"#000000\"></line><line x1=\"93.75\" y1=\"0\" x2=\"93.75\" y2=\"225\" stroke=\"#000000\"></line><polygon points=\"265,135 258,131 258,139\" fill=\"#000000\" stroke=\"#000000\"></polygon><polygon points=\"93.75,0 89.75,7 97.75,7\" fill=\"#000000\" stroke=\"#000000\"></polygon><foreignObject x=\"251\" y=\"105\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>x</mi></math></div></foreignObject><foreignObject x=\"101.75\" y=\"-2\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>y</mi></math></div></foreignObject><line x1=\"18.75\" y1=\"131\" x2=\"18.75\" y2=\"139\" stroke=\"#000000\"></line><foreignObject x=\"14.75\" y=\"143\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mrow><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></math></div></foreignObject><line x1=\"168.75\" y1=\"131\" x2=\"168.75\" y2=\"139\" stroke=\"#000000\"></line><foreignObject x=\"164.75\" y=\"143\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mn>1</mn></math></div></foreignObject><line x1=\"89.75\" y1=\"210\" x2=\"97.75\" y2=\"210\" stroke=\"#000000\"></line><foreignObject x=\"69.75\" y=\"198\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mrow><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></math></div></foreignObject><line x1=\"89.75\" y1=\"60\" x2=\"97.75\" y2=\"60\" stroke=\"#000000\"></line><foreignObject x=\"69.75\" y=\"48\" width=\"32\" height=\"32\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mn>1</mn></math></div></foreignObject><foreignObject x=\"77.75\" y=\"135\" width=\"14\" height=\"22\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>O</mi></math></div></foreignObject><polyline points=\"18.75,135 19.5,124.419948015