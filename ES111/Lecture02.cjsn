76700364,119.2596318480791 465.53586290303275,119.77744786102406 466.0318781360291,120.293167570858 466.5278933690255,120.80690459039253 467.02390860202183,121.3187708828402 467.5199238350182,121.82887686355299 468.0159390680145,122.3373314989935 468.5119543010109,122.84424240313321 469.00796953400726,123.34971593146466 469.50398476700366,123.85385727280796 470,124.3567705390828\" fill=\"none\" stroke=\"#4169e1\" stroke-width=\"2\"></polyline></svg><figcaption>The graph of the tangent function in red and the cotangent function in blue.</figcaption></figure>","hidden":true,"type":"code"},{"input":"const xmid = 240;\nconst ymid = 130;\nconst scale = 50;\n\nconst figure = JSCells.figure(\n  { width: 470, height: 260 },\n  \"The graph of the secans function in red and the cosecans function in blue.\"\n);\n\nfigure.axes({\n  origin: [xmid, ymid],\n  scale,\n  x: { ticks: [] },\n  y: { ticks: [-2, -1, 1, 2] },\n});\n\nconst plotSegment = (fn, domain, stroke) => {\n  figure.plot(fn, {\n    domain,\n    samples: Math.ceil((domain[1] - domain[0]) / 0.01) + 1,\n    stroke,\n    width: 2,\n  });\n};\n\nconst addAsymptote = (x, stroke) => {\n  figure\n    .line()\n    .x1(x)\n    .y1(0)\n    .x2(x)\n    .y2(260)\n    .stroke(stroke)\n    .setAttribute(\"stroke-dasharray\", \"2\");\n};\n\nconst addTick = (value) => {\n  const x = xmid + scale * value;\n\n  figure\n    .line()\n    .x1(x)\n    .y1(ymid - 4)\n    .x2(x)\n    .y2(ymid + 4)\n    .stroke(\"#000000\")\n    .strokeWidth(1);\n\n  return x;\n};\n\nconst xTicks = [\n  [String.raw`-\\uppi`, -Math.PI, 24],\n  [String.raw`-\\frac{\\uppi}{2}`, -Math.PI / 2, 30],\n  [String.raw`\\frac{\\uppi}{2}`, Math.PI / 2, 30],\n  [String.raw`\\uppi`, Math.PI, 18],\n];\n\nfor (const [label, value, labelWidth] of xTicks) {\n  const x = addTick(value);\n\n  figure.label(label, {\n    x: x - labelWidth / 2,\n    y: ymid + 10,\n    latex: true,\n    width: labelWidth,\n    height: 32,\n  });\n}\n\nconst secant = (x) => 1 / Math.cos(x);\nconst cosecant = (x) => 1 / Math.sin(x);\n\nconst secantRight = Math.acos(50 / 130);\nconst secantLeft = -secantRight;\nconst red = \"#b33a36\";\nconst blue = \"#4169e1\";\n\nplotSegment(\n  secant,\n  [secantLeft - Math.PI, secantRight - Math.PI],\n  red\n);\n\naddAsymptote(xmid - scale * Math.PI / 2, red);\n\nplotSegment(secant, [secantLeft, secantRight], red);\n\naddAsymptote(xmid + scale * Math.PI / 2, red);\n\nplotSegment(\n  secant,\n  [secantLeft + Math.PI, secantRight + Math.PI],\n  red\n);\n\nconst cosecantLeft = Math.asin(50 / 130);\nconst cosecantRight = Math.PI - cosecantLeft;\n\nplotSegment(\n  cosecant,\n  [-240 / 50, cosecantRight - 2 * Math.PI],\n  blue\n);\n\naddAsymptote(xmid - scale * Math.PI, blue);\n\nplotSegment(\n  cosecant,\n  [cosecantLeft - Math.PI, cosecantRight - Math.PI],\n  blue\n);\n\nplotSegment(\n  cosecant,\n  [cosecantLeft, cosecantRight],\n  blue\n);\n\naddAsymptote(xmid + scale * Math.PI, blue);\n\nplotSegment(\n  cosecant,\n  [cosecantLeft + Math.PI, 230 / 50],\n  blue\n);\n\nfigure;","output":"","result":"xy−2−112−π−π2π2πThe graph of the secans function in red and the cosecans function in blue.","resultHTML":"<figure><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"470\" height=\"260\" viewBox=\"0 0 470 260\"><line x1=\"0\" y1=\"130\" x2=\"470\" y2=\"130\" stroke=\"#000000\"></line><line x1=\"240\" y1=\"0\" x2=\"240\" y2=\"260\" stroke=\"#000000\"></line><polygon points=\"470,130 463,126 463,134\" fill=\"#000000\" stroke=\"#000000\"></polygon><polygon points=\"240,0 236,7 244,7\" fill=\"#000000\" stroke=\"#000000\"></polygon><foreignObject x=\"456\" y=\"100\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>x</mi></math></div></foreignObject><foreignObject x=\"248\" y=\"-2\" width=\"14\" height=\"28\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><math><mi>y</mi></math></div></foreignObject><line x1=\"236\" y1=\"230\" x2=\"244\" y2=\"230\" stroke=\"#000000\"></line><foreignObject x=\"216\" y=\"218\" wid